{
 "extends": "splinter_mite",
 "id": "splinter_mite_reef",
 "name": "Splinter Mite · Reef variant",
 "role": "Add mob variant · Ring 2 Coral Drift, summoned by Tidewraith",
 "notes": [
  "Same rig, bones, animations and hitbox as the base Splinter Mite; only texture and added boxes change.",
  "Coral shell with pores; a small coral branch and a barnacle replace the splinter chips; a kelp strand trails from the tail.",
  "The kelp strand reaches past the hitbox; it is cosmetic and can sway in idle and walk.",
  "Spawns instead of the base Mite on Coral Drift islands and when Tidewraith calls adds."
 ],
 "palette": {"shell": "#c9607a", "shell_hi": "#dd8a78", "head": "#b0586c", "under": "#5e3444", "coral_hi": "#ffd2bd", "kelp": "#4f7a3a"},
 "materials": {"shell": "coral", "shell_hi": "coral", "head": "coral", "kelp": "kelp"},
 "remove_boxes": ["chip L", "chip R"],
 "add_boxes": [
  {"name": "coral branch", "bone": "body", "from": [-3, 6, -1], "to": [-2, 9, 0], "color": "shell_hi", "texture": "coral"},
  {"name": "coral twig", "bone": "body", "from": [-4, 8, -1], "to": [-3, 9, 0], "color": "shell_hi", "texture": "coral"},
  {"name": "barnacle", "bone": "body", "from": [2, 6, 2], "to": [3, 7, 3], "color": "bone"},
  {"name": "kelp strand", "bone": "body", "from": [-0.5, 3, 6], "to": [0.5, 4, 9], "color": "kelp"}
 ],
 "callouts": {
  "front": [["eye R", "Glowing eyes"], ["coral branch", "Coral branch"], ["splinter", "Splinter stays violet"]],
  "left": [["coral twig", "Branching coral"], ["splinter", "Splinter"], ["kelp strand", "Kelp strand (sways)"], ["head", "Coral head"]],
  "top": [["coral branch", "Coral branch"], ["barnacle", "Barnacle"], ["kelp strand", "Kelp strand"]],
  "bottom": [["belly", "Underbelly"], ["leg L1", "Leg sockets"]]
 }
}
