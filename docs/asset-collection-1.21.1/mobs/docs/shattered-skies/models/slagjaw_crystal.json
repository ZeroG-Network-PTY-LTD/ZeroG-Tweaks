{
 "extends": "slagjaw",
 "id": "slagjaw_crystal",
 "name": "Slagjaw · Crystal style",
 "role": "Boss style · Ring 3 Crystal islands · same abilities as Slagjaw",
 "notes": [
  "Same rig, bones, animations and hitbox as Slagjaw; only textures and added boxes change.",
  "Pale calcite body, dark basalt fists and jaw, amethyst clusters growing from the shoulders and back; bracers and cage are amethyst.",
  "Amethyst is a different purple from the splinter on purpose: amethyst is pinker and duller, the splinter is brighter and glows.",
  "Spawns on Crystal islands (Ring 3) instead of the base look."
 ],
 "palette": {"stone": "#e2ddd6", "stone_dark": "#44404a", "copper": "#8a5cc8", "patina": "#b48ae6", "amethyst": "#a46ad0", "iron": "#dff6f4", "gold": "#e6d8ff"},
 "materials": {"stone": "calcite", "stone_dark": "deepslate", "copper": "splinter_dim", "amethyst": "splinter_dim"},
 "remove_boxes": ["copper vent L", "copper vent R"],
 "add_boxes": [
  {"name": "cluster L", "bone": "arm_l", "from": [-24, 44, -9], "to": [-19, 50, -4], "color": "amethyst"},
  {"name": "cluster L tip", "bone": "arm_l", "from": [-23, 50, -8], "to": [-20, 54, -5], "color": "amethyst"},
  {"name": "cluster R", "bone": "arm_r", "from": [19, 44, -6], "to": [24, 49, -1], "color": "amethyst"},
  {"name": "back cluster", "bone": "back", "from": [-8, 48, 0], "to": [-3, 55, 5], "color": "amethyst"},
  {"name": "back cluster 2", "bone": "back", "from": [4, 48, -3], "to": [8, 53, 1], "color": "amethyst"}
 ],
 "callouts": {
  "front": [["eye R", "Glowing eyes"], ["cluster L tip", "Amethyst clusters on the shoulders"], ["tooth iron", "Pale crystal teeth"], ["splinter core", "Splinter in an amethyst cage"], ["torso", "Calcite body"], ["fist L", "Basalt fists"]],
  "left": [["back cluster", "Amethyst on the back"], ["shoulders", "Calcite"], ["jaw", "Basalt jaw"], ["bracer L", "Amethyst bracers"], ["fist L", "Fist"]],
  "top": [["back cluster", "Back clusters"], ["cluster R", "Shoulder clusters"], ["tooth diamond", "Teeth"], ["fist R", "Fists"]],
  "bottom": [["fist L", "Fist knuckles"], ["foot R", "Feet"], ["jaw", "Jaw underside"]]
 }
}
