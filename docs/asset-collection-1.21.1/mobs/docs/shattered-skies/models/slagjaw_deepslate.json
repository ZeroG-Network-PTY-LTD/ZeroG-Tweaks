  "front": [["eye R", "Glowing eyes"], ["tooth iron", "Deep ore teeth (lapis replaces iron)"], ["splinter core", "Splinter in a gold cage"], ["bracer L", "Gold bracers"], ["torso", "Deepslate with glowing veins"]],
  "left": [["stalagmite L tip", "Stalagmite spikes"], ["shoulders", "Deepslate tiles"], ["jaw", "Jaw"], ["forearm L", "Veined forearm"], ["fist L", "Fist"]],
  "top": [["stalagmite L", "Stalagmites"], ["back slab", "Back plate"], ["tooth diamond", "Ore teeth"], ["fist R", "Fists"]],
