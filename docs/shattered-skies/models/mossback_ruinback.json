{
 "extends": "mossback",
 "id": "mossback_ruinback",
 "name": "Mossback · Ruinback style",
 "role": "Boss style · Ring 2–3 Ruins · same abilities",
 "notes": [
  "Same rig, bones, animations and hitbox as Mossback; only textures and added boxes change.",
  "It grew up among Warden ruins: its mantle is mossy rubble, a broken Warden pillar is grown into its back beside the splinter, and its horns are cracked like old stone.",
  "The pillar sits on the mantle bone and tilts with it; a teal Warden sigil is still visible on the pillar.",
  "Spawns on Ruins and Great Ruins islands."
 ],
 "palette": {"stone": "#8a8683", "stone_dark": "#5a5653", "horn": "#a8a39c", "plate": "#dcd6cc", "brass": "#b8913f", "sigil": "#4fd1c5"},
 "materials": {"moss": "mossy_cobble", "horn": "cobble"},
 "unshaded": ["sigil"],
 "remove_boxes": ["mushroom stem", "mushroom cap"],
 "add_boxes": [
  {"name": "pillar", "bone": "mantle", "from": [-15, 34, 0], "to": [-9, 46, 6], "color": "plate", "texture": "calcite"},
  {"name": "pillar cap", "bone": "mantle", "from": [-16, 46, -1], "to": [-8, 48, 7], "color": "plate", "texture": "calcite"},
  {"name": "pillar sigil", "bone": "mantle", "from": [-13.5, 39, -0.3], "to": [-10.5, 42, 0], "color": "sigil", "decal": "front"},
  {"name": "rubble", "bone": "mantle", "from": [10, 34, -8], "to": [15, 37, -3], "color": "stone_dark", "texture": "cobble"}
 ],
 "callouts": {
  "front": [["pillar sigil", "Broken Warden pillar with a sigil"], ["splinter", "Splinter (violet)"], ["horn curl L", "Cracked stone horns"], ["moss drape R", "Mossy rubble"], ["hoof FL", "Hooves"]],
  "left": [["pillar cap", "Pillar grown into its back"], ["mantle", "Mossy rubble mantle"], ["horn curl L", "Stone horn"], ["body", "Fur"], ["tail tuft", "Tail tuft"]],
  "top": [["pillar cap", "Pillar"], ["rubble", "Rubble"], ["splinter", "Splinter"], ["fern", "Fern"]],
  "bottom": [["belly", "Belly"], ["hoof BL", "Hooves"], ["beard", "Moss beard"]]
 }
}
