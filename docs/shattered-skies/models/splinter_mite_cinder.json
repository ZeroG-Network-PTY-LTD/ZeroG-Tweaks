{
 "extends": "splinter_mite",
 "id": "splinter_mite_cinder",
 "name": "Splinter Mite · Cinder variant",
 "role": "Add mob variant · Meteor Fall event, summoned by Meteor Maw",
 "notes": [
  "Same rig, bones, animations and hitbox as the base Splinter Mite; only texture and added boxes change.",
  "Basalt shell with glowing magma cracks (paint the orange into the glow texture); two rock spikes replace the splinter chips.",
  "Side vents glow orange; the splinter stays violet so it still reads as a Splinterborn.",
  "Spawns instead of the base Mite during Meteor Fall and when Meteor Maw calls adds."
 ],
 "palette": {"shell": "#3a3436", "shell_hi": "#4a4245", "head": "#403a3c", "under": "#1f1b1c", "ember": "#ff8a2a"},
 "materials": {"shell": "rock", "shell_hi": "rock", "head": "rock", "ember": "ember"},
 "unshaded": ["ember"],
 "remove_boxes": ["chip L", "chip R"],
 "add_boxes": [
  {"name": "rock spike L", "bone": "body", "from": [-3, 6, -1], "to": [-2, 9, 0], "color": "shell_hi", "texture": "rock"},
  {"name": "rock spike R", "bone": "body", "from": [2, 6, 2], "to": [3, 9, 3], "color": "shell_hi", "texture": "rock"},
  {"name": "ember vent", "bone": "body", "from": [-4.2, 3, 0], "to": [-4, 5, 3], "color": "ember", "decal": "left"},
  {"name": "ember mouth", "bone": "head", "from": [-1, 2, -6.2], "to": [1, 3, -6], "color": "ember", "decal": "front"}
 ],
 "callouts": {
  "front": [["eye R", "Glowing eyes"], ["ember mouth", "Magma glow in the mouth"], ["rock spike R", "Rock spikes"], ["splinter", "Splinter stays violet"]],
  "left": [["rock spike L", "Basalt spike"], ["ember vent", "Glowing side vent"], ["shell", "Magma cracks in the shell"], ["head", "Basalt head"]],
  "top": [["rock spike R", "Rock spikes"], ["shell", "Magma cracks"], ["mandible R", "Mandibles"]],
  "bottom": [["belly", "Dark underbelly"], ["leg L1", "Leg sockets"]]
 }
}
