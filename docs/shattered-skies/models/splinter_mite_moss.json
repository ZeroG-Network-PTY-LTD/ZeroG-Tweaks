{
 "extends": "splinter_mite",
 "id": "splinter_mite_moss",
 "name": "Splinter Mite · Moss variant",
 "role": "Add mob variant · Ring 1 Verdant islands, summoned by Mossback",
 "notes": [
  "Same rig, bones, animations and hitbox as the base Splinter Mite; only texture and added boxes change.",
  "Moss grows over the shell and hangs off both sides; a fern and a small mushroom replace the splinter chips.",
  "Added boxes sit on existing bones (moss and fern on body, mushroom on splinter), so every base animation works unchanged.",
  "Spawns instead of the base Mite on Verdant islands and when Mossback calls adds."
 ],
 "palette": {"shell": "#3f6b3a", "shell_hi": "#557f3f", "head": "#4d5a3a", "moss_hi": "#9ccf5a", "shell_dark": "#3a3152", "leaf": "#6fa840", "mushroom": "#c8453b"},
 "materials": {"shell": "moss", "shell_hi": "moss", "head": "moss", "leaf": "leaf"},
 "remove_boxes": ["chip L", "chip R"],
 "add_boxes": [
  {"name": "moss drape L", "bone": "body", "from": [-4.5, 4, -2], "to": [-4, 6, 3], "color": "shell_hi", "texture": "moss"},
  {"name": "moss drape R", "bone": "body", "from": [4, 4, -2], "to": [4.5, 6, 3], "color": "shell_hi", "texture": "moss"},
  {"name": "fern", "bone": "body", "from": [2, 6, 1], "to": [3, 9, 3], "color": "leaf", "texture": "leaf"},
  {"name": "mushroom stem", "bone": "splinter", "from": [-3, 6, -1], "to": [-2, 7, 0], "color": "bone"},
  {"name": "mushroom cap", "bone": "splinter", "from": [-3.5, 7, -1.5], "to": [-1.5, 8, 0.5], "color": "mushroom"}
 ],
 "callouts": {
  "front": [["eye R", "Glowing eyes (unchanged)"], ["moss drape R", "Moss hangs off both sides"], ["splinter", "Splinter stays violet on every variant"]],
  "left": [["mushroom cap", "Small red mushroom"], ["fern", "Fern sprout"], ["shell", "Moss over the shell plates"], ["head", "Mossy head"]],
  "top": [["fern", "Fern"], ["mushroom cap", "Mushroom cap"], ["shell ridge", "Moss ridge"]],
  "bottom": [["belly", "Underbelly unchanged"], ["leg L1", "Leg sockets"]]
 }
}
